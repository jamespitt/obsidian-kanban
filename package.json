{
  "name": "obsidian-kanban",
  "version": "0.12.0",
  "description": "A Kanban board for Obsidian driven by #ToDo/#InProgress/#Done tags on your real tasks.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "kanban",
    "board",
    "task-management"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "16.18.126",
    "esbuild": "0.28.0",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.1.9",
    "globals": "14.0.0",
    "jiti": "2.7.0",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  },
  "dependencies": {
    "obsidian": "latest"
  }
}
